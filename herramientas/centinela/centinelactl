#!/bin/bash
# centinelactl — control del centinela de privacidad.
set -uo pipefail

BASE="$HOME/.config/centinela"
source "$BASE/config.sh"

ETIQUETA="io.ejemplo.centinela"
PLIST="$HOME/Library/LaunchAgents/$ETIQUETA.plist"
APP="$BASE/Centinela.app/Contents/MacOS/centinela"
REFS="$BASE/referencias/fotos"
BITACORA="$BASE/registro/bitacora.csv"

v()  { printf '\033[1;32m%s\033[0m\n' "$*"; }
a()  { printf '\033[1;33m%s\033[0m\n' "$*"; }
r()  { printf '\033[1;31m%s\033[0m\n' "$*"; }
t()  { printf '\033[1m%s\033[0m\n' "$*"; }

uso() {
  cat <<AYUDA
centinelactl — centinela de privacidad

  enrolar       Toma fotos tuyas de referencia y calibra el reconocimiento.
                Es el primer paso: sin esto no distingue tu cara de otra.
  instalar      Deja el centinela corriendo y que arranque solo al iniciar sesión.
  estado        ¿Está corriendo? Configuración y últimos eventos.
  probar        Fuerza una verificación ahora mismo (toma foto y evalúa).
  bitacora      Todos los eventos registrados.
  alertas       Solo los eventos de desconocido, con sus fotos.
  reiniciar     Recarga la configuración.
  detener       Lo apaga (sin desinstalar).
  desinstalar   Lo quita todo, incluyendo fotos y bitácora.
AYUDA
}

requiere_enrolamiento() {
  if [ ! -s "$BASE/referencias/huellas.archive" ]; then
    r "Todavía no has enrolado tu rostro."
    echo "   Corre primero:  centinelactl enrolar"
    return 1
  fi
}

cmd_enrolar() {
  mkdir -p "$REFS"
  t "Enrolamiento de tu rostro"
  echo
  echo "Voy a tomar 6 fotos tuyas para que el centinela aprenda a reconocerte."
  echo "Mientras más variadas, mejor distingue. El LED de la cámara va a prender."
  echo
  echo "Acomódate frente a la cámara como te sientas normalmente a trabajar."
  read -r -p "Enter cuando estés lista (o Ctrl-C para salir)... " _

  local indicaciones=(
    "mirando al frente, normal"
    "mirando al frente otra vez"
    "voltea un poco la cara a la izquierda"
    "voltea un poco la cara a la derecha"
    "sonriendo"
    "como te sientas de verdad a trabajar"
  )
  rm -f "$REFS"/*.jpg 2>/dev/null || true

  local i=1
  for ind in "${indicaciones[@]}"; do
    echo
    a "Foto $i de 6: $ind"
    for s in 3 2 1; do printf "  %s... " "$s"; sleep 1; done
    echo
    if "$APP" capturar "$REFS/ref$i.jpg" "$CAMARA_PREFERIDA" >/dev/null 2>&1; then
      local n
      n=$("$APP" comparar "$REFS/ref$i.jpg" 2>/dev/null \
          | python3 -c 'import json,sys;print(json.load(sys.stdin).get("rostros",0))' 2>/dev/null || echo 0)
      if [ "$n" = "0" ]; then
        r "  no se detectó rostro en esta foto — se va a ignorar"
      else
        v "  ✓ rostro detectado"
      fi
    else
      r "  falló la captura"
    fi
    i=$((i+1))
  done

  echo
  t "Calibrando..."
  local salida
  salida=$("$APP" enrolar "$REFS" 2>&1)
  echo "$salida" | python3 -c '
import json, sys
try: d = json.load(sys.stdin)
except Exception:
    print("  no se pudo interpretar la salida del enrolamiento"); raise SystemExit(1)
if not d.get("ok"):
    print("  ERROR: " + str(d.get("error"))); raise SystemExit(1)
usadas = d.get("fotos_usadas", [])
ign = d.get("fotos_ignoradas", [])
print(f"  fotos que sirvieron: {len(usadas)}")
for x in ign: print(f"  ignorada: {x}")
print(f"  variación entre tus propias fotos: prom {d[\"distancia_entre_tus_fotos_prom\"]:.1f}, max {d[\"distancia_entre_tus_fotos_max\"]:.1f}")
print(f"  umbral calibrado: {d[\"umbral_calculado\"]:.1f}")
print()
print("  Lectura: si una cara queda a una distancia MENOR al umbral, eres tú.")
'
  echo
  v "Listo. Ahora:  centinelactl probar"
}

cmd_instalar() {
  requiere_enrolamiento || return 1
  mkdir -p "$HOME/Library/LaunchAgents"
  cat > "$PLIST" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$ETIQUETA</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>$BASE/bin/vigia</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardErrorPath</key>
	<string>$BASE/registro/stderr.log</string>
	<key>StandardOutPath</key>
	<string>$BASE/registro/stdout.log</string>
</dict>
</plist>
PLISTEOF
  launchctl bootout "gui/$UID/$ETIQUETA" 2>/dev/null || true
  launchctl bootstrap "gui/$UID" "$PLIST" 2>&1 | head -3
  sleep 2
  if launchctl print "gui/$UID/$ETIQUETA" >/dev/null 2>&1; then
    v "✓ Centinela instalado y corriendo. Arranca solo al iniciar sesión."
  else
    r "No se pudo cargar el servicio. Revisa: $BASE/registro/stderr.log"
  fi
}

cmd_estado() {
  t "Centinela — estado"
  echo
  if launchctl print "gui/$UID/$ETIQUETA" 2>/dev/null | grep -q "state = running"; then
    v "  servicio: corriendo"
  elif [ -f "$PLIST" ]; then
    a "  servicio: instalado pero no corriendo"
  else
    a "  servicio: no instalado  (centinelactl instalar)"
  fi

  if [ -s "$BASE/referencias/huellas.archive" ]; then
    local u; u=$(cat "$BASE/referencias/umbral.txt" 2>/dev/null || echo "?")
    v "  tu rostro: enrolado (umbral $u)"
  else
    a "  tu rostro: SIN enrolar  (centinelactl enrolar)"
  fi

  local rssi; rssi=$(python3 "$BASE/bin/watch_rssi.py" "$WATCH_ADDR" 2>/dev/null || echo ausente)
  if [ "$rssi" = "ausente" ]; then
    a "  Apple Watch: fuera de rango"
  else
    v "  Apple Watch: $rssi dBm (umbral $WATCH_RSSI_MINIMO)"
  fi

  echo "  cámara: ${CAMARA_PREFERIDA:-automática}"
  echo "  avisos: $NTFY_SERVIDOR/$NTFY_TOPIC"
  echo "  foto en el push: $([ "$ENVIAR_FOTO" = 1 ] && echo sí || echo 'no (se queda local)')"
  echo
  t "Últimos eventos"
  if [ -s "$BITACORA" ]; then
    tail -6 "$BITACORA" | column -t -s, 2>/dev/null | sed 's/^/  /'
  else
    echo "  (ninguno todavía)"
  fi
}

cmd_probar() {
  t "Verificación de prueba"
  bash "$BASE/bin/vigia" --una-vez
  echo
  tail -2 "$BITACORA" | column -t -s, 2>/dev/null | sed 's/^/  /'
  echo
  tail -1 "$BASE/registro/vigia.log"
}

cmd_bitacora() {
  if [ -s "$BITACORA" ]; then column -t -s, < "$BITACORA" | less -S
  else echo "Sin eventos registrados."; fi
}

cmd_alertas() {
  t "Eventos de desconocido"
  echo
  if ! grep -q DESCONOCIDO "$BITACORA" 2>/dev/null; then
    v "  Ninguno. Nadie que no seas tú ha usado tu Mac desde que instalaste esto."
    return
  fi
  grep DESCONOCIDO "$BITACORA" | column -t -s, | sed 's/^/  /'
  echo
  echo "  Fotos en: $BASE/registro/fotos/"
  read -r -p "  ¿Abrir la carpeta de fotos? [s/N] " resp
  [[ "$resp" =~ ^[sS]$ ]] && open "$BASE/registro/fotos/"
}

cmd_reiniciar() {
  launchctl kickstart -k "gui/$UID/$ETIQUETA" 2>&1 | head -3
  v "✓ Reiniciado con la configuración actual."
}

cmd_detener() {
  launchctl bootout "gui/$UID/$ETIQUETA" 2>/dev/null \
    && v "✓ Detenido." || a "No estaba corriendo."
}

cmd_desinstalar() {
  r "Esto borra el servicio, tus fotos de referencia, las capturas y la bitácora."
  read -r -p "¿Seguro? Escribe 'borrar' para confirmar: " resp
  if [ "$resp" != "borrar" ]; then echo "Cancelado."; return; fi
  launchctl bootout "gui/$UID/$ETIQUETA" 2>/dev/null || true
  rm -f "$PLIST"
  rm -rf "$BASE"
  v "✓ Desinstalado por completo."
}

case "${1:-}" in
  enrolar)     cmd_enrolar ;;
  instalar)    cmd_instalar ;;
  estado)      cmd_estado ;;
  probar)      cmd_probar ;;
  bitacora)    cmd_bitacora ;;
  alertas)     cmd_alertas ;;
  reiniciar)   cmd_reiniciar ;;
  detener)     cmd_detener ;;
  desinstalar) cmd_desinstalar ;;
  *)           uso ;;
esac
