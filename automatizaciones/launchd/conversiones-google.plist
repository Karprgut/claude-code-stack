<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.ejemplo.tbp-conversiones-google</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-I</string>
    <string>/Users/<usuario>/automatizaciones/reporte-leads/subir_conversiones_google.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>5</integer></dict>
  <key>StandardOutPath</key><string>/Users/<usuario>/automatizaciones/reporte-leads/logs/conversiones-google.log</string>
  <key>StandardErrorPath</key><string>/Users/<usuario>/automatizaciones/reporte-leads/logs/conversiones-google.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
