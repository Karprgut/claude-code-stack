<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.ejemplo.tablero-vacantes</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/<usuario>/herramientas/tablero-vacantes/empujar.py</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/<usuario>/.config/tablero-vacantes/empuje.log</string>
  <key>StandardErrorPath</key><string>/Users/<usuario>/.config/tablero-vacantes/empuje.log</string>
</dict>
</plist>
