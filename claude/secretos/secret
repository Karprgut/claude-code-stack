#!/usr/bin/env python3
"""secret — consulta y sincroniza los .env de todos los proyectos desde ~/.secrets

  secret list [slug]            nombres de variables (sin valores)
  secret get VAR [slug]         imprime UN valor
  secret where VAR              en que archivos vive y si coinciden (por hash)
  secret check                  divergencias, duplicados y cruces entre inquilinos
  secret diff [slug|--all]      compara el render del vault contra el archivo en disco
  secret sync [slug|--all]      escribe el archivo desde el vault (respalda antes)
  secret files                  el manifiesto
  secret notas                  credenciales sin proyecto asignado

El vault es la fuente de verdad. Renuevas un token una vez y `secret sync --all`
lo propaga a todas las copias.
"""
import hashlib, os, pathlib, re, shutil, sys, time

HOME  = pathlib.Path.home()
VAULT = HOME / ".secrets"

def die(m, code=1):
    print(m, file=sys.stderr); sys.exit(code)

if not VAULT.exists():
    die(f"no existe {VAULT}")

def read_env(p):
    out = {}
    if not p.exists(): return out
    for ln in p.read_text(errors="replace").splitlines():
        l = ln.strip()
        if not l or l.startswith("#") or "=" not in l: continue
        k, v = l.split("=", 1)
        out[k.strip()] = v
    return out

def manifest():
    rows = []
    for ln in (VAULT / "manifest.tsv").read_text().splitlines():
        if not ln.strip() or ln.startswith("#"): continue
        slug, tenant, rel = ln.split("\t")
        rows.append((slug, tenant, rel))
    return rows

MAN = manifest()
SLUGS  = {s: (t, r) for s, t, r in MAN}
TENANT = {}
for f in (VAULT / "tenants").glob("*.env"):
    TENANT[f.stem] = read_env(f)

def resolve(slug):
    """valores efectivos del archivo: inquilino + propios (propios ganan)."""
    t, _ = SLUGS[slug]
    v = dict(TENANT.get(t, {}))
    v.update(read_env(VAULT / "files" / f"{slug}.env"))
    return v

def render(slug):
    tmpl = (VAULT / "templates" / f"{slug}.tmpl").read_text()
    vals = resolve(slug)
    for k, v in vals.items():
        tmpl = tmpl.replace("${" + k + "}", v)
    return tmpl

def h6(v):
    return "(vacio)" if v == "" else hashlib.sha1(v.encode()).hexdigest()[:6]

def target(slug):
    return HOME / SLUGS[slug][1]

# ---------------------------------------------------------------- comandos
def cmd_files(_):
    print(f"{'slug':<15} {'inquilino':<10} destino")
    for s, t, r in MAN:
        print(f"{s:<15} {t:<10} {r}")

def cmd_list(a):
    if a and a[0] in SLUGS:
        for k in sorted(resolve(a[0])): print(k)
    elif a:
        die(f"slug desconocido: {a[0]}\nslugs: {' '.join(SLUGS)}")
    else:
        for t, d in sorted(TENANT.items()):
            print(f"# inquilino {t} ({len(d)})")
            for k in sorted(d): print(f"  {k}")

def cmd_get(a):
    if not a: die("uso: secret get VAR [slug]")
    var = a[0]
    if len(a) > 1:
        if a[1] not in SLUGS: die(f"slug desconocido: {a[1]}")
        v = resolve(a[1]).get(var)
        if v is None: die(f"{var} no esta en {a[1]}")
        print(v); return
    hits = {s: resolve(s)[var] for s in SLUGS if var in resolve(s)}
    if not hits: die(f"{var} no existe en ningun archivo")
    vals = set(hits.values())
    if len(vals) == 1:
        print(vals.pop()); return
    print(f"{var} tiene {len(vals)} valores distintos — especifica el slug:", file=sys.stderr)
    for s, v in hits.items(): print(f"  {s:<15} [{h6(v)}]", file=sys.stderr)
    sys.exit(2)

def cmd_where(a):
    if not a: die("uso: secret where VAR")
    var = a[0]
    hits = {s: resolve(s)[var] for s in SLUGS if var in resolve(s)}
    if not hits: die(f"{var} no existe en ningun archivo")
    groups = {}
    for s, v in hits.items(): groups.setdefault(h6(v), []).append(s)
    print(f"{var} — {len(hits)} copias, {len(groups)} valor(es) distinto(s)")
    for h, ss in groups.items():
        ts = sorted({SLUGS[s][0] for s in ss})
        print(f"  [{h}] {', '.join(ss)}   ({'+'.join(ts)})")
    if len(groups) > 1: print("  ⚠ divergente: decide cual es el canonico")

def cmd_check(_):
    rc = 0
    print("== claves duplicadas dentro de un mismo archivo ==")
    dup = False
    for s in SLUGS:
        p = target(s)
        if not p.exists(): continue
        seen, ds = {}, []
        for ln in p.read_text(errors="replace").splitlines():
            l = ln.strip()
            if not l or l.startswith("#") or "=" not in l: continue
            k = l.split("=", 1)[0].strip()
            seen[k] = seen.get(k, 0) + 1
        for k, n in seen.items():
            if n > 1: ds.append(f"{k} x{n}")
        if ds:
            dup = True; rc = 1
            print(f"  ⚠ {s}: {', '.join(ds)}   (gana la ultima, silenciosamente)")
    if not dup: print("  ninguna")

    print("\n== lineas que parecen credencial pero NO son variable valida ==")
    mal = False
    VALID = re.compile(r'^\s*(export\s+)?[A-Za-z_][A-Za-z0-9_]*=')
    for s_ in SLUGS:
        p_ = target(s_)
        if not p_.exists(): continue
        for i, ln in enumerate(p_.read_text(errors="replace").splitlines(), 1):
            if "=" not in ln: continue
            if ln.lstrip().startswith("#"): continue      # comentario, inerte a proposito
            if VALID.match(ln): continue
            mal = True; rc = 1
            key = ln.split("=", 1)[0]
            print(f"  \u26a0 {s_}:{i}  llave invalida {key!r} — ningun loader de .env la lee")
    if not mal: print("  ninguna")

    nd = VAULT / "notas"
    if nd.exists():
        ns = sorted(nd.glob("*.env"))
        if ns:
            print("\n== notas del vault (credenciales sin proyecto asignado) ==")
            for f in ns:
                ks = [l.split("=")[0] for l in f.read_text().splitlines()
                      if l and not l.startswith("#") and "=" in l]
                print(f"  {f.name}: {', '.join(ks)}")

    print("\n== misma variable con valores distintos dentro del inquilino ==")
    any_d = False
    for t in sorted({t for _, t, _ in MAN}):
        slugs = [s for s in SLUGS if SLUGS[s][0] == t]
        keys = {k for s in slugs for k in resolve(s)}
        for k in sorted(keys):
            hs = {s: h6(resolve(s)[k]) for s in slugs if k in resolve(s)}
            if len(set(hs.values())) > 1:
                any_d = True
                print(f"  {t:<9} {k:<34} " + "  ".join(f"{s}[{h}]" for s, h in hs.items()))
    if not any_d: print("  ninguna")

    print("\n== mismo valor compartido entre inquilinos distintos ==")
    any_x = False
    allkeys = {k for s in SLUGS for k in resolve(s)}
    for k in sorted(allkeys):
        by = {}
        for s in SLUGS:
            v = resolve(s).get(k)
            if v is not None: by.setdefault(h6(v), set()).add(SLUGS[s][0])
        for h, ts in by.items():
            if len(ts) > 1:
                any_x = True
                print(f"  {k:<34} [{h}] compartido por {'+'.join(sorted(ts))}")
    if not any_x: print("  ninguno")
    return rc

def cmd_diff(a):
    slugs = list(SLUGS) if (not a or a[0] == "--all") else [a[0]]
    bad = 0
    for s in slugs:
        p = target(s)
        if not p.exists():
            print(f"  {s:<15} destino no existe: {p}"); bad += 1; continue
        cur, new = p.read_text(errors="replace"), render(s)
        if cur == new:
            print(f"  {s:<15} identico ✓")
        else:
            bad += 1
            cl, nl = cur.split("\n"), new.split("\n")
            print(f"  {s:<15} ⚠ DIFERENTE ({len(cl)} vs {len(nl)} lineas)")
            for i in range(max(len(cl), len(nl))):
                c = cl[i] if i < len(cl) else "<falta>"
                n = nl[i] if i < len(nl) else "<falta>"
                if c != n:
                    ck = c.split("=")[0][:40]; nk = n.split("=")[0][:40]
                    print(f"      linea {i+1}: disco[{ck}] vs vault[{nk}]")
    return 1 if bad else 0

def cmd_sync(a):
    if not a: die("uso: secret sync <slug>|--all")
    slugs = list(SLUGS) if a[0] == "--all" else [a[0]]
    stamp = time.strftime("%Y%m%d-%H%M%S")
    for s in slugs:
        if s not in SLUGS: die(f"slug desconocido: {s}")
        p, new = target(s), render(s)
        if p.exists():
            cur = p.read_text(errors="replace")
            if cur == new:
                print(f"  {s:<15} sin cambios"); continue
            bk = p.with_suffix(p.suffix + f".bak-{stamp}")
            shutil.copy2(p, bk); os.chmod(bk, 0o600)
            print(f"  {s:<15} respaldo -> {bk.name}")
        p.write_text(new); os.chmod(p, 0o600)
        print(f"  {s:<15} escrito ✓ {p}")
    return 0

def cmd_notas(_):
    nd = VAULT / "notas"
    if not nd.exists() or not list(nd.glob("*.env")):
        print("sin notas"); return 0
    for f in sorted(nd.glob("*.env")):
        print(f"# {f.name}")
        for l in f.read_text().splitlines():
            if l.startswith("#") or not l.strip(): continue
            if "=" in l: print("   " + l.split("=")[0])
    print("\nvalores:  secret notas-get NOMBRE")
    return 0

def cmd_notas_get(a):
    if not a: die("uso: secret notas-get NOMBRE")
    for f in (VAULT / "notas").glob("*.env"):
        for l in f.read_text().splitlines():
            if l.startswith("#") or "=" not in l: continue
            k, v = l.split("=", 1)
            if k == a[0]: print(v); return 0
    die(f"{a[0]} no esta en las notas")

CMDS = {"files": cmd_files, "notas": cmd_notas, "notas-get": cmd_notas_get, "list": cmd_list, "get": cmd_get, "where": cmd_where,
        "check": cmd_check, "diff": cmd_diff, "sync": cmd_sync}

if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
    print(__doc__); sys.exit(0)
c = sys.argv[1]
if c not in CMDS: die(f"comando desconocido: {c}\n\n{__doc__}")
sys.exit(CMDS[c](sys.argv[2:]) or 0)
