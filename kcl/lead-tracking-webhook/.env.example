# Copia este archivo a .env.local para correr `vercel dev` localmente.
# En Vercel producción, definir estas variables en
# Project → Settings → Environment Variables.

# 1) Secreto del webhook — invéntalo (string aleatorio largo)
#    Después se usa en la URL del webhook como ?secret=...
BREVO_WEBHOOK_SECRET=cambia-esto-por-un-string-aleatorio

# 2) Google Analytics 4 — Measurement Protocol
#    GA4 Admin → Data Streams → Web → Measurement ID
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
#    GA4 Admin → Data Streams → Web → Measurement Protocol API secrets → Create
GA4_API_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# 3) Meta Conversions API
#    Events Manager → Pixel → Settings
META_PIXEL_ID=000000000000000
#    Events Manager → Pixel → Settings → Conversions API → Generate access token
META_CAPI_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 4) URL canónica del formulario (para event_source_url en CAPI)
EVENT_SOURCE_URL=https://www.tu-sitio.com/
