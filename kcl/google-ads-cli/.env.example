# ── Credenciales de Google Ads API ──────────────────────────────
# Copia este archivo a ".env" y rellena los valores.
# NUNCA subas el .env a git (ya está en .gitignore).

# 1) Developer token  (Google Ads → Herramientas → API Center)
GOOGLE_ADS_DEVELOPER_TOKEN=

# 2) OAuth client  (Google Cloud Console → APIs y servicios → Credenciales)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# 3) Refresh token  (lo genera el script `npm run token`)
GOOGLE_ADS_REFRESH_TOKEN=

# 4) IDs de cuenta (10 dígitos, SIN guiones)
#    login_customer_id = la cuenta ADMINISTRADORA (MCC)
#    customer_id        = la cuenta donde se crea la campaña
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
