{%- comment -%}
  analytics-datalayer.liquid
  Empuja eventos de storefront al dataLayer (esquema GA4 ecommerce) para que el
  contenedor GTM-XXXXXXX mapee Meta Pixel / TikTok Pixel / Google Ads.

  NO toca GA4: su ecommerce lo manda la app Google & YouTube (Customer Events).
  Eventos emitidos:
    · view_item      (página de producto, vía Liquid)
    · add_to_cart    (intercepta POST /cart/add[.js])
    · generate_lead  (intercepta POST /api/strategy/preview del wizard)
    · begin_checkout (clic a /checkout o botón name="checkout")
  El purchase NO sale de aquí: el theme no corre en checkout. Va por el Web Pixel
  de Customer Events + server (Meta CAPI / TikTok). Ver karma-backend/lib/tracking.
{%- endcomment -%}

<script>
  window.dataLayer = window.dataLayer || [];
</script>

{%- if template.name == 'product' and product -%}
<script>
  window.dataLayer.push({ ecommerce: null });
  window.dataLayer.push({
    event: 'view_item',
    ecommerce: {
      currency: {{ cart.currency.iso_code | default: shop.currency | json }},
      value: {{ product.price | divided_by: 100.0 | json }},
      items: [{
        item_id: {{ product.id | append: '' | json }},
        item_name: {{ product.title | json }},
        item_brand: {{ product.vendor | json }},
        item_category: {{ product.type | json }},
        price: {{ product.price | divided_by: 100.0 | json }},
        quantity: 1
      }]
    }
  });
</script>
{%- endif -%}

<script>
(function () {
  if (window.__karmaDLBound) return;
  window.__karmaDLBound = true;

  var CURRENCY = {{ cart.currency.iso_code | default: shop.currency | json }};
  var dl = window.dataLayer;

  function push(obj) { try { dl.push(obj); } catch (e) {} }

  // --- generate_lead + add_to_cart: interceptar fetch -----------------------
  if (window.fetch) {
    var _fetch = window.fetch;
    window.fetch = function (input, init) {
      var url = (typeof input === 'string' ? input : (input && input.url)) || '';
      var p = _fetch.apply(this, arguments);

      if (/\/api\/strategy\/preview/.test(url)) {
        p.then(function (r) {
          if (r && r.ok) push({ event: 'generate_lead', lead_source: 'estrategia_wizard', currency: CURRENCY });
        }).catch(function () {});
      }

      if (/\/cart\/add(\.js)?(\?|$)/.test(url)) {
        p.then(function () {
          var qty = 1, id = null;
          try {
            var body = init && init.body;
            if (typeof body === 'string') {
              var j = JSON.parse(body);
              id = j.id || (j.items && j.items[0] && j.items[0].id) || null;
              qty = j.quantity || (j.items && j.items[0] && j.items[0].quantity) || 1;
            }
          } catch (e) {}
          push({ ecommerce: null });
          push({
            event: 'add_to_cart',
            ecommerce: { currency: CURRENCY, items: [{ item_id: String(id || ''), quantity: qty }] }
          });
        }).catch(function () {});
      }
      return p;
    };
  }

  // --- begin_checkout: clic a /checkout o botón de checkout -----------------
  document.addEventListener('click', function (e) {
    var el = e.target && e.target.closest ? e.target.closest('a,button,input') : null;
    if (!el) return;
    var href = el.getAttribute && (el.getAttribute('href') || '');
    var name = el.getAttribute && (el.getAttribute('name') || '');
    if ((href && /\/checkout/.test(href)) || name === 'checkout') {
      push({ event: 'begin_checkout', ecommerce: { currency: CURRENCY } });
    }
  }, true);
})();
</script>
