# =============================================================================
#  KARMA · TRACKING / CONVERSIONS ENV  (template — safe to commit)
# =============================================================================
#  Env dedicado SOLO para el sistema de tracking (Meta CAPI, TikTok Events API,
#  GA4 Measurement Protocol, Google Ads). No mezclar con secretos de la app.
#
#  USO
#  ----
#  Local:   copia este archivo a `.env.tracking.local` y llena los valores.
#           `.env.tracking.local` está en .gitignore (lo cubre `.env*.local`),
#           y lo auto-carga lib/tracking/env.ts en desarrollo.
#  Vercel:  NO se sube ningún archivo. Mete estas mismas variables en
#           Project → Settings → Environment Variables (Production + Preview).
#
#  PÚBLICO vs SECRETO
#  ------------------
#  *_PIXEL_ID, *_MEASUREMENT_ID, *_ADS_ID  → públicos (se ven en el navegador).
#  *_TOKEN, *_API_SECRET                   → SECRETOS. Nunca al theme/cliente.
# =============================================================================

# ----- Meta (Facebook) -------------------------------------------------------
# Pixel ID: Events Manager → Data Sources → tu pixel (15-16 dígitos). PÚBLICO.
META_PIXEL_ID=
# Conversions API token: Events Manager → Settings → Generate access token. SECRETO.
META_CAPI_TOKEN=
# Opcional: código de prueba para ver eventos en Test Events. Vacío en prod.
META_TEST_EVENT_CODE=
# Versión del Graph API (déjalo así salvo que sepas que cambió).
META_GRAPH_VERSION=v21.0

# ----- TikTok ----------------------------------------------------------------
# Pixel/Web Event Code: Events Manager → tu pixel (ej. C1AB2...). PÚBLICO.
TIKTOK_PIXEL_ID=
# Events API Access Token: Events Manager → Settings → Generate Access Token. SECRETO.
TIKTOK_EVENTS_TOKEN=
# Opcional: test_event_code para Test Events. Vacío en prod.
TIKTOK_TEST_EVENT_CODE=

# ----- GA4 (Measurement Protocol, solo server-side) --------------------------
# Measurement ID del data stream web. PÚBLICO. (Karma = G-XXXXXXXXXX)
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# API secret: GA4 Admin → Data Streams → tu stream → Measurement Protocol API
# secrets → Create. SECRETO.
GA4_API_SECRET=

# ----- Google Ads ------------------------------------------------------------
# Conversion ID con prefijo AW-. PÚBLICO. (Karma = AW-XXXXXXXXXX)
GOOGLE_ADS_ID=AW-XXXXXXXXXX
# Conversion label de COMPRA (el que sigue al "/" en send_to). PÚBLICO.
GOOGLE_ADS_PURCHASE_LABEL=<CONVERSION_LABEL>
# Conversion label de LEAD (déjalo vacío si aún no creas la acción en Ads). PÚBLICO.
GOOGLE_ADS_LEAD_LABEL=

# ----- Control ---------------------------------------------------------------
# Pon 1 para loguear los payloads de tracking sin enviarlos (debug local).
TRACKING_DRY_RUN=0
